#!/bin/sh

echo "Running pre-commit checks..."

# Detect source file changes only
WEB_CHANGED=$(git diff --cached --name-only | grep -E '^web/src/|^web/index\.html|^web/package\.json|^web/(vite|tsconfig)|^web/eslint\.config\.js' || true)
API_CHANGED=$(git diff --cached --name-only | grep -E '^api/.*\.(cs|csproj)$|^api/appsettings' || true)
E2E_CHANGED=$(git diff --cached --name-only | grep -E '^e2e/' || true)

WEB_LOG=$(mktemp)
API_LOG=$(mktemp)
E2E_LOG=$(mktemp)
WEB_PID=""
API_PID=""
E2E_PID=""

# Run web checks in background if web source files changed
if [ -n "$WEB_CHANGED" ]; then
  (
    FAILED=0
    echo "Web: Formatting check..."
    if ! npm run web:format:check; then FAILED=1; fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "Web: Linting..."
      if ! npm run web:lint; then FAILED=1; fi
    fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "Web: Building..."
      if ! npm run web:build; then FAILED=1; fi
    fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "Web: Testing..."
      if ! npm run web:test; then FAILED=1; fi
    fi

    exit $FAILED
  ) > "$WEB_LOG" 2>&1 &
  WEB_PID=$!
fi

# Run API checks in background if API source files changed
if [ -n "$API_CHANGED" ]; then
  (
    FAILED=0
    echo "API: Formatting check..."
    if ! npm run api:format:check; then FAILED=1; fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "API: Building..."
      if ! npm run api:build; then FAILED=1; fi
    fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "API: Testing..."
      if ! npm run api:test; then FAILED=1; fi
    fi

    exit $FAILED
  ) > "$API_LOG" 2>&1 &
  API_PID=$!
fi

# Run e2e checks in background if e2e files changed
if [ -n "$E2E_CHANGED" ]; then
  (
    FAILED=0
    echo "E2E: Formatting check..."
    if ! npm run e2e:format:check; then FAILED=1; fi

    if [ $FAILED -eq 0 ]; then
      echo ""
      echo "E2E: Linting..."
      if ! npm run e2e:lint; then FAILED=1; fi
    fi

    exit $FAILED
  ) > "$E2E_LOG" 2>&1 &
  E2E_PID=$!
fi

# Wait for all and collect exit codes
WEB_EXIT=0
API_EXIT=0
E2E_EXIT=0

if [ -n "$WEB_PID" ]; then
  wait "$WEB_PID"
  WEB_EXIT=$?
fi

if [ -n "$API_PID" ]; then
  wait "$API_PID"
  API_EXIT=$?
fi

if [ -n "$E2E_PID" ]; then
  wait "$E2E_PID"
  E2E_EXIT=$?
fi

# Print outputs
if [ -n "$WEB_CHANGED" ]; then
  echo ""
  echo "-- Web ------------------------------------------"
  cat "$WEB_LOG"
else
  echo ""
  echo "Web: No source changes detected, skipping checks"
fi

if [ -n "$API_CHANGED" ]; then
  echo ""
  echo "-- API ------------------------------------------"
  cat "$API_LOG"
else
  echo ""
  echo "API: No source changes detected, skipping checks"
fi

if [ -n "$E2E_CHANGED" ]; then
  echo ""
  echo "-- E2E ------------------------------------------"
  cat "$E2E_LOG"
else
  echo ""
  echo "E2E: No source changes detected, skipping checks"
fi

rm -f "$WEB_LOG" "$API_LOG" "$E2E_LOG"

if [ $WEB_EXIT -ne 0 ] || [ $API_EXIT -ne 0 ] || [ $E2E_EXIT -ne 0 ]; then
  echo ""
  echo "Pre-commit checks failed!"
  exit 1
fi

echo ""
echo "All checks passed!"
