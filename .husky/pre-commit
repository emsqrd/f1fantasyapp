#!/bin/sh

echo "Running pre-commit checks..."

# Detect source file changes only
WEB_CHANGED=$(git diff --cached --name-only | grep -E '^web/src/|^web/index\.html|^web/package\.json|^web/(vite|tsconfig)' || true)
API_CHANGED=$(git diff --cached --name-only | grep -E '^api/.*\.(cs|csproj)$|^api/appsettings' || true)

WEB_LOG=$(mktemp)
API_LOG=$(mktemp)
WEB_PID=""
API_PID=""

# Run web checks in background if web source files changed
if [ -n "$WEB_CHANGED" ]; then
  {
    echo "Web: Linting..."
    npm run web:lint || exit 1

    echo ""
    echo "Web: Building..."
    npm run web:build || exit 1

    echo ""
    echo "Web: Testing..."
    npm run web:test || exit 1
  } > "$WEB_LOG" 2>&1 &
  WEB_PID=$!
fi

# Run API checks in background if API source files changed
if [ -n "$API_CHANGED" ]; then
  {
    echo "API: Formatting check..."
    npm run api:format:check || exit 1

    echo ""
    echo "API: Building..."
    npm run api:build || exit 1

    echo ""
    echo "API: Testing..."
    npm run api:test || exit 1
  } > "$API_LOG" 2>&1 &
  API_PID=$!
fi

# Wait for both and collect exit codes
WEB_EXIT=0
API_EXIT=0

if [ -n "$WEB_PID" ]; then
  wait "$WEB_PID"
  WEB_EXIT=$?
fi

if [ -n "$API_PID" ]; then
  wait "$API_PID"
  API_EXIT=$?
fi

# Print outputs
if [ -n "$WEB_CHANGED" ]; then
  echo ""
  echo "-- Web ------------------------------------------"
  cat "$WEB_LOG"
else
  echo ""
  echo "Web: No source changes detected, skipping checks"
fi

if [ -n "$API_CHANGED" ]; then
  echo ""
  echo "-- API ------------------------------------------"
  cat "$API_LOG"
else
  echo ""
  echo "API: No source changes detected, skipping checks"
fi

rm -f "$WEB_LOG" "$API_LOG"

if [ $WEB_EXIT -ne 0 ] || [ $API_EXIT -ne 0 ]; then
  echo ""
  echo "Pre-commit checks failed!"
  exit 1
fi

echo ""
echo "All checks passed!"
