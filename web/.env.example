# Copy to .env and fill in: cp .env.example .env
# Vite inlines every VITE_* var into the client bundle, so none of these are secret.

# --- Required ---
VITE_F1_FANTASY_API=http://localhost:5077/api
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Local anon key from `supabase status` (or your project's publishable anon key)
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# --- Optional ---
# Error tracking. Leave empty to disable Sentry.
VITE_SENTRY_DSN=
# Event sampling. Unset defaults to 1.0 in dev, 0.1 in prod.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
# Devtools widgets (development). Set to "true" to show.
VITE_ROUTER_DEVTOOLS=false
VITE_QUERY_DEVTOOLS=false
